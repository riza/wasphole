# wasphole configuration example
# Copy to config.yaml and fill in required fields before starting.

# ── Instance ─────────────────────────────────────────────────────────────────
# Controls which OS environment is simulated.
instance:
  # Required. Simulated operating system.
  # Accepted values: "linux", "windows"
  mode: linux

  # Optional. Industry context used to shape AI-generated identities and
  # responses. Examples: "fintech", "healthcare", "saas", "ecommerce"
  industry: fintech

  # Optional. Fixed random seed for deterministic identity generation.
  # Leave empty to generate a new identity on first startup.
  # Two deployments with different seeds produce different identities.
  seed: ""

# ── AI ───────────────────────────────────────────────────────────────────────
# Controls the AI provider used for identity and response generation.
ai:
  # Required. API protocol to use.
  # Accepted values:
  #   "anthropic" — Anthropic Messages API (Claude models)
  #   "openai"    — OpenAI Chat Completions API (OpenAI, DeepSeek, MiniMax, GLM, etc.)
  api_type: anthropic

  # Optional. Custom API base URL.
  # Leave empty to use the provider's standard endpoint.
  # Examples:
  #   DeepSeek (Anthropic-compat):  https://api.deepseek.com/anthropic
  #   DeepSeek (OpenAI-compat):     https://api.deepseek.com/v1
  #   MiniMax:                      https://api.minimax.chat/v1
  #   GLM (Zhipu):                  https://open.bigmodel.cn/api/paas/v4
  base_url: ""

  # Optional. API key for the provider.
  # If empty, reads from ANTHROPIC_API_KEY (api_type=anthropic) or
  # OPENAI_API_KEY (api_type=openai) environment variable.
  api_key: ""

  # Required. Model ID to request from the provider.
  # Examples:
  #   Anthropic:  claude-sonnet-4-6
  #   DeepSeek:   deepseek-chat, deepseek-reasoner
  #   MiniMax:    abab6.5s-chat
  #   GLM:        glm-4-flash, glm-4
  model: claude-sonnet-4-6

  # Directory for caching AI-generated responses and identity.
  # Cached responses ensure consistency across restarts.
  # Default: "./cache"
  cache_dir: ./cache

# ── Transport ────────────────────────────────────────────────────────────────
# Controls how the MCP server accepts connections.
transport:
  # Required. Transport protocol.
  # Accepted values:
  #   "stdio" — communicate over stdin/stdout (for direct Claude integration)
  #   "http"  — listen for HTTP+SSE connections on a TCP port
  type: http

  # TCP port to listen on when type=http.
  # Default: 8080
  port: 8080

# ── Alerts ───────────────────────────────────────────────────────────────────
# One or more alert sinks. Each sink receives alert events independently.
alerts:
  sinks:
    # Stdout sink: prints JSON alert lines to stdout (always useful for debugging).
    - type: stdout
      enabled: true

    # Webhook sink: POSTs JSON alert payloads to a URL on WARN+ events.
    - type: webhook
      url: https://hooks.example.com/wasphole-alerts
      # Optional. Base64-encoded HMAC signing secret.
      # If set, outbound POSTs include webhook-id, webhook-signature, and
      # webhook-timestamp headers (Standard Webhooks spec).
      webhook_secret: ""
      enabled: false

    # SIEM sink: emits structured events for ingestion by a SIEM.
    # format: "cef"  — ArcSight Common Event Format (CEF:0) written to path or stderr
    # format: "json" — JSON events written to path or stderr
    - type: siem
      format: cef
      # Output file path. Leave empty to write CEF lines to stderr.
      # Example: path: /var/log/wasphole/siem.log
      path: ""
      enabled: false

# ── Canary ───────────────────────────────────────────────────────────────────
# Controls canary token embedding and callback delivery.
canary:
  # Base domain for DNS/URL canary tokens.
  # Canary URLs are generated for attribution, but are not blindly appended to
  # every response.
  # Leave empty to disable DNS canaries.
  domain: canary.example.com

  # URL to POST when any canary token fires.
  # Receives session ID, token type, and timestamp.
  # Leave empty to disable HTTP canary callbacks.
  http_callback: https://hooks.example.com/canary

  # Address for the built-in canary HTTP listener.
  # When set, wasphole serves /c/{token-id} on this address — fired canary tokens
  # are attributed to their originating session without an external callback.
  # Leave empty to disable (default).
  # Example: ":9090"
  listen_addr: ""

# ── Session Recording ────────────────────────────────────────────────────────
# Controls where session logs are written.
session:
  # Directory for per-session JSONL logs.
  # Each session gets a file: {log_dir}/{session_id}.jsonl
  # Default: ./sessions
  log_dir: ./sessions
